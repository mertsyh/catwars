{
  "name": "openfrontclone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:start:client\" \"npm:start:server-dev\"",
    "start:client": "vite",
    "start:server-dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.client.json && vite build",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "typescript-eslint": "^8.13.0",
    "prettier": "^3.3.0"
  }
}
